generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String   @default("password123")
  firstName       String   @default("")
  lastName        String   @default("")
  phone           String   @default("")
  userType        String   @default("CLIENT") // ADMIN, CLIENT, LIVREUR
  isActive        Boolean  @default(true)
  rating          Float    @default(5.0)
  totalDeliveries Int      @default(0)
  nationalId      String?
  memberSince     DateTime @default(now())
  street          String?
  city            String?
  commercialName  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  announcements   Announcement[]
  subscriptions   Subscription[]
  missions        Mission[]
  wallet          Wallet?
}

model Announcement {
  id                  String   @id @default(cuid())
  clientId            String
  title               String
  description         String   @default("")
  status              String   @default("PUBLISHED") // PUBLISHED, ASSIGNED, CANCELLED, DRAFT
  amount              Float    @default(0)
  recipientFirstName  String   @default("")
  recipientLastName   String   @default("")
  recipientEmail      String   @default("")
  recipientPhone      String   @default("")
  shipperFirstName    String   @default("")
  shipperLastName     String   @default("")
  shipperEmail        String   @default("")
  shipperPhone        String   @default("")
  pickupAddress       String   @default("{}") // JSON
  deliveryAddress     String   @default("{}") // JSON
  packet              String   @default("{}") // JSON
  distance            Float?
  duration            Float?
  transportMethod     String   @default("driving")
  paymentMethod       String   @default("CASH")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client              User         @relation(fields: [clientId], references: [id])
  subscriptions       Subscription[]
  assignedDeliveryPersonId String?
}

model Subscription {
  id                String       @id @default(cuid())
  announcementId    String
  deliveryPersonId  String
  status            String       @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt         DateTime     @default(now())

  announcement      Announcement @relation(fields: [announcementId], references: [id])
  deliveryPerson    User         @relation(fields: [deliveryPersonId], references: [id])

  @@unique([announcementId, deliveryPersonId])
}

model Mission {
  id              String   @id @default(cuid())
  title           String
  description     String   @default("")
  status          String   @default("PENDING") // PENDING, ASSIGNED, EN_COURS, TERMINEE
  amount          Float    @default(0)
  shipperFirstName String   @default("")
  shipperLastName  String   @default("")
  shipperEmail     String   @default("")
  pickupAddress   String   @default("{}") // JSON {street, district, city, latitude, longitude}
  deliveryAddress String   @default("{}") // JSON {street, district, city, latitude, longitude}
  packet          String   @default("{}") // JSON {designation, weight, length, width, height, description}
  distance        Float?
  duration        Float?
  transportMethod String   @default("driving")
  paymentMethod   String   @default("CASH")
  assignedToId    String?  // ID du freelancer (User)
  assignedTo      User?    @relation(fields: [assignedToId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Wallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  balance       Float    @default(0)
  totalEarnings Float    @default(0)
  pendingAmount Float    @default(0)
  lastMonth     Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User         @relation(fields: [userId], references: [id])
  transactions  Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  type        String   @default("GAIN") // GAIN, RETRAIT
  amount      Float
  description String   @default("")
  status      String   @default("COMPLETED") // COMPLETED, PENDING, FAILED
  createdAt   DateTime @default(now())

  wallet      Wallet   @relation(fields: [walletId], references: [id])
}