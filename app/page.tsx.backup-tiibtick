'use client'

import { useEffect, useState, useCallback, useRef } from 'react'
import {
  Settings, Calendar, Tag, Package, ShieldCheck, Shield, Award, CheckCircle,
  Clock, Smile, Box, CreditCard, Lock, QrCode,
  AlertTriangle, ChevronDown, FileText, Smartphone, Wine, Archive,
  Menu, X, Handshake,
} from 'lucide-react'
import { Switch } from '@/components/ui/switch'

/* ════════════════════════════════════════════
   TiiBnTick — Gestion du Profil Freelancer
   ════════════════════════════════════════════ */

/* ─── Types ─── */
interface DaySlot { day: string; enabled: boolean; start: string; end: string }
interface ParcelType { id: string; label: string; icon: React.ReactNode; checked: boolean }

/* ─── Data ─── */
const DAYS_INITIAL: DaySlot[] = [
  { day: 'Lundi',    enabled: true,  start: '08:00', end: '18:00' },
  { day: 'Mardi',    enabled: true,  start: '08:00', end: '18:00' },
  { day: 'Mercredi', enabled: true,  start: '08:00', end: '18:00' },
  { day: 'Jeudi',    enabled: true,  start: '08:00', end: '18:00' },
  { day: 'Vendredi', enabled: true,  start: '08:00', end: '18:00' },
  { day: 'Samedi',   enabled: false, start: '09:00', end: '13:00' },
  { day: 'Dimanche', enabled: false, start: '09:00', end: '13:00' },
]

const SIDEBAR_SECTIONS = [
  { id: 'settings',    label: '1. Paramètres de Profil' },
  { id: 'intro',       label: '2. Engagement Logistique' },
  { id: 'eligibility', label: "3. Conditions d'Éligibilité" },
  { id: 'conduct',     label: '4. Règles de Conduite' },
  { id: 'payment',     label: '5. Politique de Paiement' },
  { id: 'safety',      label: '6. Sécurité et Assurance' },
  { id: 'termination', label: '7. Résiliation' },
]

/* ─── Component ─── */
export default function TiiBnTickPage() {
  const [days, setDays] = useState<DaySlot[]>(DAYS_INITIAL)
  const [pricePerKm, setPricePerKm] = useState('250')
  const [pricePerM3, setPricePerM3] = useState('1500')
  const [overtimeEnabled, setOvertimeEnabled] = useState(true)
  const [overtimeRate, setOvertimeRate] = useState('50')
  const [weightMin, setWeightMin] = useState('0')
  const [weightMax, setWeightMax] = useState('50')
  const [parcels, setParcels] = useState<ParcelType[]>([
    { id: 'standard',     label: 'Standard',     icon: <Archive className="w-7 h-7" />,     checked: true },
    { id: 'electronique', label: 'Électronique', icon: <Smartphone className="w-7 h-7" />,  checked: true },
    { id: 'fragile',      label: 'Fragile',      icon: <Wine className="w-7 h-7" />,        checked: false },
    { id: 'documents',    label: 'Documents',    icon: <FileText className="w-7 h-7" />,     checked: true },
  ])
  const [activeSection, setActiveSection] = useState('settings')
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false)

  /* Scroll spy */
  useEffect(() => {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActiveSection(entry.target.id)
        }
      },
      { rootMargin: '-20% 0px -70% 0px' }
    )
    document.querySelectorAll('.tt-section').forEach((s) => observer.observe(s))
    return () => observer.disconnect()
  }, [])

  const toggleDay = useCallback((idx: number) =>
    setDays((p) => p.map((d, i) => (i === idx ? { ...d, enabled: !d.enabled } : d))), [])
  const updateDayTime = useCallback((idx: number, field: 'start' | 'end', v: string) =>
    setDays((p) => p.map((d, i) => (i === idx ? { ...d, [field]: v } : d))), [])
  const toggleParcel = useCallback((id: string) =>
    setParcels((p) => p.map((x) => (x.id === id ? { ...x, checked: !x.checked } : x))), [])
  const scrollTo = useCallback((id: string) => {
    document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' })
    setMobileMenuOpen(false)
  }, [])

  /* ─── Section Icon Wrapper ─── */
  function SectionIcon({ bg, color, children }: { bg: string; color: string; children: React.ReactNode }) {
    return (
      <div className="w-12 h-12 flex items-center justify-center shrink-0"
        style={{ backgroundColor: bg, borderRadius: 'var(--tt-radius-full)', color }}>
        {children}
      </div>
    )
  }

  /* ═══════════════════════════════════════════
     RENDER
     ═══════════════════════════════════════════ */
  return (
    <div className="tiibtick min-h-screen flex flex-col"
      style={{ backgroundColor: 'var(--tt-bg)', color: 'var(--tt-on-background)' }}>

      {/* ══════════ TopNavBar ══════════ */}
      <nav className="fixed top-0 w-full z-50 tt-glass-nav"
        style={{ borderBottom: '1px solid var(--tt-border-subtle)' }}>
        <div className="flex justify-between items-center mx-auto h-20"
          style={{ maxWidth: 'var(--tt-container)', padding: '0 var(--tt-margin-d)' }}>
          {/* Logo */}
          <div className="flex items-center gap-2">
            <span className="tt-headline-md tracking-tight" style={{ color: 'var(--tt-primary)' }}>TiiBnTick</span>
            <span className="text-white px-2 py-0.5 uppercase tracking-widest"
              style={{ backgroundColor: 'var(--tt-primary)', fontSize: '10px', fontWeight: 700, borderRadius: 'var(--tt-radius)' }}>
              Freelancer
            </span>
          </div>
          {/* Desktop links */}
          <div className="hidden md:flex items-center" style={{ gap: 'var(--tt-gutter)' }}>
            {['Go', 'Freelancer', 'Solutions', 'Resources'].map((link, i) => (
              <a key={link} href="#" className="tt-body-md transition-colors duration-200"
                style={i === 1
                  ? { color: 'var(--tt-primary)', fontWeight: 700, borderBottom: '2px solid var(--tt-primary)', paddingBottom: 4 }
                  : { color: 'var(--tt-on-surface)', fontWeight: 500 }
                }
                onMouseEnter={(e) => { if (i !== 1) e.currentTarget.style.color = 'var(--tt-primary)' }}
                onMouseLeave={(e) => { if (i !== 1) e.currentTarget.style.color = 'var(--tt-on-surface)' }}>
                {link}
              </a>
            ))}
          </div>
          <div className="flex items-center gap-3">
            <button className="text-white px-6 py-2.5 tt-label-bold active:scale-95 transition-transform"
              style={{ backgroundColor: 'var(--tt-primary)', borderRadius: 'var(--tt-radius-lg)' }}>
              Connect
            </button>
            <button
              className="md:hidden flex items-center justify-center w-11 h-11 border active:scale-95 transition-transform"
              style={{ borderColor: 'var(--tt-border-subtle)', color: 'var(--tt-on-surface)', borderRadius: 'var(--tt-radius-lg)' }}
              aria-label={mobileMenuOpen ? 'Fermer le menu' : 'Ouvrir le menu'}
              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
            >
              {mobileMenuOpen ? <X className="w-6 h-6" /> : <Menu className="w-6 h-6" />}
            </button>
          </div>
        </div>
        {/* Mobile menu */}
        {mobileMenuOpen && (
          <div style={{ borderTop: '1px solid var(--tt-border-subtle)', backgroundColor: 'var(--tt-surface-container-lowest)' }}>
            <div className="flex flex-col p-4 gap-1">
              {['Go', 'Freelancer', 'Solutions', 'Resources'].map((link) => (
                <a key={link} href="#"
                  className="px-4 py-3 tt-body-md"
                  style={{ borderRadius: 'var(--tt-radius-lg)', color: link === 'Freelancer' ? 'var(--tt-primary)' : 'var(--tt-on-surface)', fontWeight: link === 'Freelancer' ? 700 : 500 }}>
                  {link}
                </a>
              ))}
            </div>
          </div>
        )}
      </nav>

      {/* ══════════ Hero Section ══════════ */}
      <header className="pt-32 pb-16 overflow-hidden relative"
        style={{ backgroundColor: 'var(--tt-surface-container-low)' }}>
        <div className="relative z-10" style={{ maxWidth: 'var(--tt-container)', margin: '0 auto', padding: '0 var(--tt-margin-d)' }}>
          <div style={{ maxWidth: '42rem' }}>
            <h1 className="tt-headline-xl" style={{ color: 'var(--tt-on-surface)', marginBottom: '24px' }}>
              Gestion du Profil et Politiques Freelancer
            </h1>
            <p className="tt-body-lg" style={{ color: 'var(--tt-on-surface-variant)' }}>
              Pilotez votre activité, configurez vos tarifs et consultez nos engagements pour une collaboration transparente et sécurisée.
            </p>
          </div>
        </div>
      </header>

      {/* ══════════ Main Layout ══════════ */}
      <main className="flex-1 flex flex-col md:flex-row py-16 mx-auto"
        style={{ maxWidth: 'var(--tt-container)', padding: '64px var(--tt-margin-d)', gap: 'var(--tt-gutter)' }}>

        {/* ── Sticky Sidebar (desktop) ── */}
        <aside className="hidden md:block md:w-1/4 h-fit md:sticky md:top-28">
          <nav className="flex flex-col gap-1"
            style={{ borderLeft: '1px solid var(--tt-border-subtle)' }}>
            {SIDEBAR_SECTIONS.map((s) => (
              <a key={s.id}
                className={`tt-sidebar-link px-4 py-3 cursor-pointer ${activeSection === s.id ? 'active' : ''}`}
                style={activeSection !== s.id ? { color: 'var(--tt-on-surface-variant)' } : undefined}
                onClick={() => scrollTo(s.id)}>
                {s.label}
              </a>
            ))}
          </nav>
        </aside>

        {/* Mobile dropdown */}
        <div className="md:hidden mb-4">
          <div className="relative">
            <select className="w-full p-3 appearance-none tt-label-bold pr-10"
              style={{ borderRadius: 'var(--tt-radius-lg)', borderColor: 'var(--tt-border-subtle)', backgroundColor: 'var(--tt-surface-container-lowest)', color: 'var(--tt-on-surface)' }}
              value={activeSection} onChange={(e) => scrollTo(e.target.value)}>
              {SIDEBAR_SECTIONS.map((s) => <option key={s.id} value={s.id}>{s.label}</option>)}
            </select>
            <ChevronDown className="w-4 h-4 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none"
              style={{ color: 'var(--tt-on-surface-variant)' }} />
          </div>
        </div>

        {/* ── Content ── */}
        <div className="md:w-3/4 space-y-12">

          {/* ═══ 1. PARAMÈTRES DE PROFIL ═══ */}
          <section id="settings" className="tt-section scroll-mt-32">
