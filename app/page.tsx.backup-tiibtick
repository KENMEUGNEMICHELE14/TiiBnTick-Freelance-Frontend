              style={{ backgroundImage: "url('https://lh3.googleusercontent.com/aida-public/AB6AXuDjymlqklLr7InD9hs_A3r9aV_avn4HV8NFvWCyP4ZGBV-PiZPR8LcJ7UQlx5Hbz0xFGeddrOnbRxt8XZXDzJEkZhVsjasIwgkiGI7pJPxvJyOoK9rISrh0GKYz34XqWPgJUACZcHvugdL9ZKPp5xtydyYQR4y_K2REJy9D2voyhKGa6-d7eOQJKSXMCMW0436QCZHr-DxRT78h8hHprTUHkirG2AyCQyNXa3HigkBN2is0_gYEW4qp')" }}
              role="img" aria-label="Livreur professionnel TiiBnTick" />
            <div className="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end p-8">
              <p className="text-white tt-headline-md italic">&ldquo;Rapidité. Précision. Professionnalisme.&rdquo;</p>
            </div>
          </div>

          {/* ═══ 4. RÈGLES DE CONDUITE ═══ */}
          <section id="conduct" className="tt-section scroll-mt-32">
            <div className="p-6 md:p-8 tt-content-card" style={{ backgroundColor: 'var(--tt-surface-container-lowest)', borderRadius: 'var(--tt-radius-xl)' }}>
              <div className="flex items-center gap-4 mb-6">
                <SectionIcon bg="var(--tt-tertiary-fixed)" color="var(--tt-tertiary)">
                  <Handshake className="w-6 h-6" />
                </SectionIcon>
                <h2 className="tt-headline-lg" style={{ color: 'var(--tt-on-surface)' }}>Règles de Conduite</h2>
              </div>
              <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
