                  <div className="space-y-3">
                    {days.map((day, idx) => (
                      <div key={day.day}
                        className="grid grid-cols-1 md:grid-cols-[120px_1fr_1fr] items-center gap-4 p-3 border transition-colors"
                        style={{ borderColor: 'var(--tt-border-subtle)', borderRadius: 'var(--tt-radius-lg)' }}
                        onMouseEnter={(e) => { e.currentTarget.style.backgroundColor = 'var(--tt-surface-container)' }}
                        onMouseLeave={(e) => { e.currentTarget.style.backgroundColor = 'transparent' }}>
                        <label className="flex items-center gap-3 cursor-pointer">
                          <input type="checkbox" checked={day.enabled} onChange={() => toggleDay(idx)}
                            className="rounded" />
                          <span className="tt-label-bold">{day.day}</span>
                        </label>
                        <div className="flex flex-col gap-1">
                          <label className="uppercase tracking-wider" style={{ fontSize: '10px', fontWeight: 700, color: 'var(--tt-on-surface-variant)' }}>Début</label>
                          <input type="time" value={day.start} onChange={(e) => updateDayTime(idx, 'start', e.target.value)} disabled={!day.enabled}
                            className="p-2 text-sm border disabled:opacity-40"
                            style={{ borderRadius: 'var(--tt-radius)', borderColor: 'var(--tt-border-subtle)' }} />
                        </div>
                        <div className="flex flex-col gap-1">
                          <label className="uppercase tracking-wider" style={{ fontSize: '10px', fontWeight: 700, color: 'var(--tt-on-surface-variant)' }}>Fin</label>
                          <input type="time" value={day.end} onChange={(e) => updateDayTime(idx, 'end', e.target.value)} disabled={!day.enabled}
                            className="p-2 text-sm border disabled:opacity-40"
                            style={{ borderRadius: 'var(--tt-radius)', borderColor: 'var(--tt-border-subtle)' }} />
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                {/* ── Tarification ── */}
                <div className="pt-6" style={{ borderTop: '1px solid var(--tt-border-subtle)' }}>
                  <h3 className="tt-headline-md mb-4 flex items-center gap-2" style={{ color: 'var(--tt-on-surface)' }}>
                    <Tag className="w-5 h-5" style={{ color: 'var(--tt-primary)' }} />
                    Tarification du Service
                  </h3>
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    {[
                      { label: 'Prix par kilomètre (XAF)', value: pricePerKm, set: setPricePerKm, unit: '/km' },
                      { label: 'Prix par mètre cube (XAF)', value: pricePerM3, set: setPricePerM3, unit: '/m³' },
                    ].map((f) => (
                      <div key={f.label} className="flex flex-col gap-1.5">
                        <label className="tt-label-bold" style={{ color: 'var(--tt-on-surface)' }}>{f.label}</label>
                        <div className="relative">
                          <input type="number" value={f.value} onChange={(e) => f.set(e.target.value)}
                            className="w-full p-3 pr-12 border"
                            style={{ borderRadius: 'var(--tt-radius-lg)', borderColor: 'var(--tt-border-subtle)' }} />
                          <span className="absolute right-4 top-1/2 -translate-y-1/2 tt-label-sm" style={{ color: 'var(--tt-on-surface-variant)' }}>{f.unit}</span>
                        </div>
                      </div>
                    ))}
                  </div>

                  {/* Overtime toggle */}
                  <div className="mt-8 p-4" style={{ backgroundColor: 'var(--tt-surface-container)', borderRadius: 'var(--tt-radius-xl)' }}>
                    <div className="flex items-center justify-between mb-4">
                      <div className="flex flex-col">
                        <span className="tt-label-bold" style={{ color: 'var(--tt-on-surface)' }}>Surfacturation par minute d&apos;attente</span>
                        <span className="tt-label-sm" style={{ color: 'var(--tt-on-surface-variant)' }}>Activez les frais pour temps d&apos;attente au ramassage/livraison</span>
                      </div>
                      <Switch checked={overtimeEnabled} onCheckedChange={setOvertimeEnabled} />
                    </div>
                    {overtimeEnabled && (
                      <div className="flex flex-col gap-1.5">
                        <label className="tt-label-bold" style={{ color: 'var(--tt-on-surface)' }}>Tarif d&apos;attente (XAF/min)</label>
                        <input type="number" value={overtimeRate} onChange={(e) => setOvertimeRate(e.target.value)}
                          className="p-3 border bg-white"
                          style={{ borderRadius: 'var(--tt-radius-lg)', borderColor: 'var(--tt-border-subtle)' }} />
                      </div>
                    )}
                  </div>
                </div>

                {/* ── Colis Acceptés ── */}
                <div className="pt-6" style={{ borderTop: '1px solid var(--tt-border-subtle)' }}>
                  <h3 className="tt-headline-md mb-4 flex items-center gap-2" style={{ color: 'var(--tt-on-surface)' }}>
                    <Package className="w-5 h-5" style={{ color: 'var(--tt-primary)' }} />
                    Colis Acceptés
                  </h3>
                  <div className="mb-6">
                    <label className="tt-label-bold block mb-2" style={{ color: 'var(--tt-on-surface)' }}>Plage de poids (kg)</label>
                    <div className="flex items-center gap-4">
                      <input type="number" value={weightMin} onChange={(e) => setWeightMin(e.target.value)} placeholder="Min"
                        className="w-full p-3 border" style={{ borderRadius: 'var(--tt-radius-lg)', borderColor: 'var(--tt-border-subtle)' }} />
                      <span style={{ color: 'var(--tt-on-surface-variant)' }}>à</span>
                      <input type="number" value={weightMax} onChange={(e) => setWeightMax(e.target.value)} placeholder="Max"
                        className="w-full p-3 border" style={{ borderRadius: 'var(--tt-radius-lg)', borderColor: 'var(--tt-border-subtle)' }} />
                    </div>
                  </div>
                  <p className="tt-label-bold mb-3" style={{ color: 'var(--tt-on-surface)' }}>Styles de colis acceptés</p>
                  <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                    {parcels.map((p) => (
                      <label key={p.id} className="tt-parcel-card group flex flex-col items-center p-4 cursor-pointer"
                        style={{
                          borderRadius: 'var(--tt-radius-xl)',
                          border: `1px solid ${p.checked ? 'var(--tt-primary)' : 'var(--tt-border-subtle)'}`,
                          backgroundColor: p.checked ? 'var(--tt-primary-fixed)' : 'transparent',
                        }}>
                        <input type="checkbox" checked={p.checked} onChange={() => toggleParcel(p.id)} className="hidden" />
                        <span className="mb-2 transition-transform group-hover:scale-110" style={{ color: 'var(--tt-primary)' }}>{p.icon}</span>
                        <span className="tt-label-sm font-bold">{p.label}</span>
                      </label>
                    ))}
                  </div>
                </div>

                {/* Save */}
                <div className="flex justify-end pt-4">
                  <button className="text-white px-8 py-3 tt-label-bold shadow-lg active:scale-95 transition-all"
                    style={{
                      backgroundColor: 'var(--tt-primary)',
                      borderRadius: 'var(--tt-radius-lg)',
                      boxShadow: '0 10px 15px -3px rgba(163,57,0,0.2)',
                    }}>
                    Enregistrer les modifications
                  </button>
                </div>
              </div>
            </div>
          </section>

          {/* ═══ 2. ENGAGEMENT LOGISTIQUE ═══ */}
          <section id="intro" className="tt-section scroll-mt-32">
            <div className="p-6 md:p-8 tt-content-card" style={{ backgroundColor: 'var(--tt-surface-container-lowest)', borderRadius: 'var(--tt-radius-xl)' }}>
              <div className="flex items-center gap-4 mb-6">
                <SectionIcon bg="var(--tt-primary-fixed)" color="var(--tt-primary)">
                  <ShieldCheck className="w-6 h-6" />
                </SectionIcon>
                <h2 className="tt-headline-lg" style={{ color: 'var(--tt-on-surface)' }}>Engagement pour une logistique professionnelle</h2>
              </div>
              <div className="space-y-4 tt-body-md leading-relaxed" style={{ color: 'var(--tt-on-surface-variant)' }}>
                <p>Chez TiiBnTick Freelancer, nous redéfinissons la logistique du dernier kilomètre par l&apos;excellence et la confiance. Notre plateforme n&apos;est pas seulement un outil de mise en relation, c&apos;est un écosystème où chaque livraison compte.</p>
                <p>Nous nous engageons à fournir une infrastructure robuste permettant aux courtiers de travailler en toute autonomie tout en garantissant un niveau de service premium pour nos clients expéditeurs.</p>
              </div>
            </div>
          </section>

          {/* ═══ 3. CONDITIONS D'ÉLIGIBILITÉ ═══ */}
          <section id="eligibility" className="tt-section scroll-mt-32">
            <div className="p-6 md:p-8 tt-content-card" style={{ backgroundColor: 'var(--tt-surface-container-lowest)', borderRadius: 'var(--tt-radius-xl)' }}>
              <div className="flex items-center gap-4 mb-6">
                <SectionIcon bg="var(--tt-secondary-fixed)" color="var(--tt-secondary)">
                  <Award className="w-6 h-6" />
                </SectionIcon>
                <h2 className="tt-headline-lg" style={{ color: 'var(--tt-on-surface)' }}>Conditions d&apos;Éligibilité</h2>
              </div>
              <p className="tt-body-md mb-6" style={{ color: 'var(--tt-on-surface-variant)' }}>
                Pour rejoindre le réseau TiiBnTick en tant que Freelancer, vous devez satisfaire aux critères suivants :
              </p>
              <ul className="grid grid-cols-1 md:grid-cols-2 gap-4">
                {[
                  { title: 'Profil Vérifié',      desc: 'Validation biométrique et vérification de l\'identité en temps réel.' },
                  { title: 'Documents Requis',     desc: 'Carte Nationale d\'Identité (CNI) ou Passeport en cours de validité.' },
                  { title: 'Permis de Conduire',   desc: 'Obligatoire pour les véhicules motorisés (moto, auto, utilitaire).' },
                  { title: 'Statut Indépendant',   desc: 'Numéro d\'immatriculation d\'entreprise ou statut auto-entrepreneur.' },
                ].map((item) => (
                  <li key={item.title} className="flex items-start gap-3 p-4"
                    style={{ backgroundColor: 'var(--tt-surface-container)', borderRadius: 'var(--tt-radius-lg)' }}>
                    <CheckCircle className="w-5 h-5 mt-0.5 shrink-0" style={{ color: 'var(--tt-success-green)' }} />
                    <div>
                      <p className="tt-label-bold" style={{ color: 'var(--tt-on-surface)' }}>{item.title}</p>
                      <p className="tt-label-sm mt-0.5" style={{ color: 'var(--tt-on-surface-variant)' }}>{item.desc}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </section>

          {/* ═══ Image Break ═══ */}
